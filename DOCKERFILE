FROM openjdk:8-jdk

# Install Python 3.9, pip, and utilities
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    wget \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Set python3 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1

# Set JAVA_HOME explicitly (for PySpark)
ENV JAVA_HOME=/usr/local/openjdk-8
ENV PATH=$JAVA_HOME/bin:$PATH

WORKDIR /app

COPY requirements.txt requirements.txt
COPY etl_postgres.py etl_postgres.py
COPY postgresql-42.7.4.jar postgresql-42.7.4.jar
COPY data/ data/

# Upgrade pip and install Python deps
# Download PostgreSQL JDBC driver
# RUN wget https://jdbc.postgresql.org/download/postgresql-42.7.4.jar -O /app/postgresql-42.7.4.jar

RUN python -m pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

ENTRYPOINT ["python", "etl_postgres.py"]